.DS_Store
node_modules/
__pycache__/
*.pyc
.venv/

# operational, not records
hunts/*/experiments/checkpoint-*.json
hunts/*/detach-*.log
hunts/*/*.lock
hunts/*/detach-*.lock.json
.vercel
.env*

# lean toolchain build state (the .lean sources and lakefile are records; this is not)
lean/**/.lake/
site/apps/skyaudit/tiles/
certs/shard-logs/
certs/erdos290-tail-shard-*.json
certs/lab-logs/

# declared work-in-progress records: a generation run rewrites these every
# few minutes and nothing on the site may quote them (see build-site's WORKING)
certs/wip-*
outreach/zenodo-bundles/

# build artifacts of the shippable environment package (rebuilt by `python -m build`)
environments/*/dist/
environments/*/*.egg-info/
environments/*/**/__pycache__/

# the Hub publication record is evidence, not a secret: it pins the pushed
# wheel by sha256 and is caught by the .env* rule above only by accident.
!environments/*/.prime/.env-metadata.json

# blind-spot: pool.json is THE RECORD (six minutes of SAT proof) and is committed.
# The rest of pool/ is a build artefact regenerated from the pinned design.il in
# about forty seconds — a compiled simulator is not a record, and it is this
# machine's binary, not a portable one. environments/blind_spot/battery.py
# rebuilds whatever is missing before it re-runs the 348 witnesses.
environments/blind_spot/pool/*
!environments/blind_spot/pool/pool.json
!environments/blind_spot/pool/pool.log

# ec-benchmark: the twelve hourly datasets are fetched from the pinned commit
# and verified by digest (tools/fetch-ec-benchmark.js); the contours are committed.
corpus/ec-benchmark/datasets/
corpus/ec-benchmark/datasets-retained/

# erdos1: a certificate whose verifier run has not finished, or whose gzipped size is over the 100 MB GitHub file limit (the d = 3375 one is 164 MB); the ledger runner scans only cert-* names
certs/erdos1/wip-*

# the return-level atlas: the full lattice of daily maxima (~450 MB), re-derivable by tools/fetch-ww3-grid.py
corpus/ww3-grid/cache/

# Petrobras Radar form answers with the operator's personal data, and dry-run screenshots
outreach/petrobras-radar/*.filled.json
outreach/petrobras-radar/run-*/
# agent worktrees (Claude Code isolation); never part of the record
.claude/worktrees/

# kissing wave: the unlicensed Takhanov-Yun archives (and any file over 3 MB), pinned by hash in
# corpus/kissing/wave.meta.json and fetched on demand (tools/pin-kissing-wave.py --fetch)
corpus/kissing/wave/.cache/
corpus/sources/delta3/.cache/
corpus/sources/zeta7-anand/.cache/

# the Prime Intellect application: the filled resume (phone, education, employment) and its PDF are personal;
# the tracked resume.md keeps the placeholders
outreach/primeintellect/resume.private.md
outreach/primeintellect/resume.pdf

# janela: the back-archive day files (resumable; `archive.py pack` writes the committed monthly records)
corpus/janela/cache/

# janela: the map field (a picture of the forecast, overwritten daily; served from the janela-field branch, not main)
corpus/janela/field/

# janela: the app's local copy of the day's data (build-today.js); the published copy rides the janela-field branch
site/janela/data/

# janela: an observed day being written (observe.py renames it into place when complete)
corpus/janela/observed/*.part

# janela: a region's back-archive day files (archive.py with JANELA_REGION; the pack beside them is committed)
corpus/janela/regions/*/cache/
# janela: a GlobCurrent day being written (currents_observe.py renames it into place when complete)
corpus/janela/currents-observed/*.part
