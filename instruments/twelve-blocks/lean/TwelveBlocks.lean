/-
  Twelve blocks: the signature at scale m + 2 equals the signature at scale m.

  GENERATED by gen.py; do not edit by hand. Core Lean 4 only (no Mathlib).
  Check:  lean TwelveBlocks.lean

  Conventions a reviewer should check by eye
  * Everything is `Int`. On `Int`, `/` is `Int.ediv` and `%` is `Int.emod`; for the
    divisor 2 these are floor division and the nonnegative remainder, i.e. Python's
    `//` and `%` (theorems `floor_conv`, `mod_conv` below state this against
    `Int.fdiv` / `Int.fmod`).
  * Block i is (a, b, s) with a = ends_i, b = ends_{i+1}, s = (-1)^i (the sign is
    carried by flipping, starting at +1).
  * Sites: for each block but the last, (b, s) then (b + 1, -s)  [e = 0, then e = 1].
  * `pairs` is itertools.combinations(·, 2) order: (x0,x1), (x0,x2), …, (x1,x2), …
-/
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace TwelveBlocks

def W : List Int := [28, 6, 28, 37, 59, 116, 116, 59, 37, 28, 6, 28]

/-- blocks (a, b, s) from left end `a` and sign `s`: lengths `w * m`, signs alternate. -/
def blocksFrom (m : Int) : Int → Int → List Int → List (Int × Int × Int)
  | _, _, [] => []
  | a, s, w :: ws => (a, a + w * m, s) :: blocksFrom m (a + w * m) (-s) ws

def blocks (m : Int) : List (Int × Int × Int) := blocksFrom m 0 1 W

/-- n = the last end. -/
def n (m : Int) : Int := (blocks m).foldl (fun _ x => x.2.1) 0

/-- prefix(t) = Σ s * min(b - a, max(0, t - a)). -/
def pref (m t : Int) : Int :=
  ((blocks m).map fun (a, b, s) => s * min (b - a) (max 0 (t - a))).sum

/-- the 22 movable sites (p, σ), in the reference order. -/
def sites (m : Int) : List (Int × Int) :=
  (blocks m).dropLast.flatMap fun (_, b, s) => [(b, s), (b + 1, -s)]

def paritySum (m p : Int) : Int :=
  ((blocks m).map fun (a, b, s) => s * ((b + p % 2) / 2 - (a + p % 2) / 2)).sum

def middle (m p : Int) : Int := pref m (2 * p - 1) - pref m (2 * p - n m - 1)

def endpoint (m p : Int) : Int := pref m ((n m + p) / 2) - pref m (p / 2)

def twice (m p σ : Int) : Int := -σ * (paritySum m p + middle m p + endpoint m p - 3 * σ)

/-- the 22 values twice(p), in site order. -/
def twiceList (m : Int) : List Int := (sites m).map fun (p, σ) => twice m p σ

/-- linear(p) = twice(p) / 2 (floor; `twice_even` proves the division is exact). -/
def linear (m : Int) : List Int := (twiceList m).map (· / 2)

def weight (n p q : Int) : Int :=
  (if (p - q) % 2 = 0 then 1 else 0)
    + (if 1 ≤ 2 * p - q ∧ 2 * p - q ≤ n then 1 else 0)
    + (if 1 ≤ 2 * q - p ∧ 2 * q - p ≤ n then 1 else 0)

/-- all unordered pairs, in itertools.combinations order. -/
def pairs {α : Type} : List α → List (α × α)
  | [] => []
  | x :: xs => xs.map (fun y => (x, y)) ++ pairs xs

/-- the 231 values quad(p, q). -/
def quadratic (m : Int) : List Int :=
  (pairs (sites m)).map fun ((p, σ), (q, τ)) => σ * τ * weight (n m) p q

def signature (m : Int) : List Int × List Int := (linear m, quadratic m)

/-! ### Floor and remainder conventions -/

theorem floor_conv (x : Int) : x / 2 = Int.fdiv x 2 :=
  (Int.fdiv_eq_ediv_of_nonneg x (by decide)).symm

theorem mod_conv (x : Int) : x % 2 = Int.fmod x 2 :=
  (Int.fmod_eq_emod_of_nonneg x (by decide)).symm

/-! ### Closed forms of n, prefix and parity_sum -/

theorem cons_congr {α : Type} {a b : α} {l l' : List α} (h1 : a = b) (h2 : l = l') :
    a :: l = b :: l' := by rw [h1, h2]

theorem n_eq (m : Int) : n m = 548 * m := by
  simp only [n, blocks, blocksFrom, W, List.foldl_cons, List.foldl_nil]
  omega

theorem pref_nonpos (m t : Int) (hm : 1 ≤ m) (ht : t ≤ 0) : pref m t = 0 := by
  simp only [pref, blocks, blocksFrom, W, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
  simp (disch := omega) only [Int.max_eq_right, Int.max_eq_left, Int.min_eq_left, Int.min_eq_right]
  omega

