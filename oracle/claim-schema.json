{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "certmachine claim (v1)",
 "description": "One claim for the oracle: a rank-R decomposition of the <n,m,p> matmul tensor over Q or F2. Entries are integers or exact rational strings 'p/q'.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "task",
  "ring",
  "witness"
 ],
 "properties": {
  "task": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "kind",
    "n",
    "m",
    "p",
    "rank"
   ],
   "properties": {
    "kind": {
     "const": "matmul"
    },
    "n": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6
    },
    "m": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6
    },
    "p": {
     "type": "integer",
     "minimum": 1,
     "maximum": 6
    },
    "rank": {
     "type": "integer",
     "minimum": 1,
     "maximum": 256
    }
   }
  },
  "ring": {
   "enum": [
    "Q",
    "F2"
   ]
  },
  "witness": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "u",
    "v",
    "w"
   ],
   "properties": {
    "u": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      }
     }
    },
    "v": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      }
     }
    },
    "w": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "items": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      }
     }
    }
   }
  }
 }
}