# warrant-grey.mplstyle: the WARRANT print register for matplotlib, every colour its greyscale value (CIE Y).
# GENERATED by design/print/kit.js in cert-machine from design/print/tokens.js and design/grammar.js; do not edit.
# Ink on white paper. Dashes carry standing and are never scaled by line width (lines.scale_dashes: False), so a
# figure emits only the patterns design/grammar.js permits. Use the helpers in warrant_mpl for standings.
figure.facecolor: ffffff
figure.edgecolor: ffffff
savefig.facecolor: ffffff
savefig.edgecolor: ffffff
savefig.transparent: False
axes.facecolor: ffffff
axes.edgecolor: 4d4d4d
axes.linewidth: 0.6
axes.labelcolor: 000000
axes.titlecolor: 000000
axes.titlesize: 9
axes.labelsize: 8
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['000000', '6a6a6a', '4d4d4d'])
grid.color: dcdcdc
grid.linewidth: 0.4
grid.linestyle: -
grid.alpha: 1.0
xtick.color: 4d4d4d
ytick.color: 4d4d4d
xtick.labelcolor: 4d4d4d
ytick.labelcolor: 4d4d4d
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.minor.width: 0.4
ytick.minor.width: 0.4
xtick.labelsize: 7
ytick.labelsize: 7
text.color: 000000
lines.linewidth: 1.5
lines.color: 000000
lines.scale_dashes: False
lines.dashed_pattern: 5, 4
lines.dotted_pattern: 1, 5
lines.markeredgewidth: 0.8
lines.markersize: 5
patch.edgecolor: 000000
patch.facecolor: 000000
patch.force_edgecolor: False
hatch.color: 8a8a8a
hatch.linewidth: 0.6
legend.frameon: False
legend.fontsize: 7
legend.framealpha: 1.0
legend.edgecolor: dcdcdc
legend.facecolor: ffffff
font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Arial, DejaVu Sans
font.size: 8
mathtext.default: regular
svg.fonttype: path
pdf.fonttype: 42
ps.fonttype: 42
image.cmap: gray_r
