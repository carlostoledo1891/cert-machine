info: EthBridge/Basic.lean:7:0: @Cslib.WordRAM.OfTuring.executes_simProgram : ∀ {k m : ℕ} {Q : Type} {tm : Turing.MultiTapeTM k Bool Q}
  {inp : List Bool} {δ : Q → Option Bool → (Fin k → Option Bool) → Turing.Action k Bool Q},
  (∀ (q : Q) (a : Option Bool) (s : Fin k → Option Bool), tm.tr q a s = δ q a s) →
    ∀ (e : Q ≃ Fin m) {t : ℕ},
      (Turing.MultiTapeTM.runFrom (tm.initCfg inp) t).state = none →
        ∀ {w : ℕ},
          Cslib.WordRAM.OfTuring.simBound k m inp.length t < 2 ^ w →
            (Turing.MultiTapeTM.runFrom (tm.initCfg inp) t).output.length < w →
              ∃ n ≤ Cslib.WordRAM.OfTuring.simTime k m t,
                Cslib.WordRAM.Executes w (Cslib.WordRAM.OfTuring.simProgram δ tm.q₀ e)
                  (Cslib.WordRAM.State.init (List.map Bool.toNat inp))
                  (Cslib.BitString.lsbValue (Turing.MultiTapeTM.runFrom (tm.initCfg inp) t).output) n
