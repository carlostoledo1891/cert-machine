'EthBridge.Anthropic.not_eth_of_ethIsFalse' depends on axioms: [propext, Classical.choice, Quot.sound]
'EthBridge.Anthropic.Assemble.decidableInExpTime' depends on axioms: [propext, Classical.choice, Quot.sound]
'EthBridge.Anthropic.DegreeStep.stepTotalD' depends on axioms: [propext, Classical.choice, Quot.sound]
'EthBridge.Anthropic.DegreeRun.runBitD' depends on axioms: [propext, Classical.choice, Quot.sound]
'EthBridge.Anthropic.Words.prep_polyTime' depends on axioms: [propext, Classical.choice, Quot.sound]
'EthBridge.Anthropic.Prep.prep_spec' depends on axioms: [propext, Classical.choice, Quot.sound]
def MainResults.ETHIsFalse : Prop :=
¬MainResults.ETH
def ComplexityAbstracts.SubexponentialSATAbstract.ETH : Prop :=
∃ δ,
  0 < δ ∧
    ¬ComplexityAbstracts.SubexponentialSATAbstract.DecidableInExpTime
        (ComplexityAbstracts.SubexponentialSATAbstract.KSAT 3) ComplexityAbstracts.SubexponentialSATAbstract.encCNF
        ComplexityAbstracts.SubexponentialSATAbstract.numVars δ
EthBridge.Anthropic.not_eth_of_ethIsFalse : MainResults.ETHIsFalse → ¬ComplexityAbstracts.SubexponentialSATAbstract.ETH
