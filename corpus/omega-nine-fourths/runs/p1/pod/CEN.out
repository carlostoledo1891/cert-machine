  {G : OAI.LinearAlgebra.MatrixExponent.Packing.HostNet F L h u} (p : S.Posting r G) (a : ℕ) (ha : a ≤ h)
  (v : G.V × OAI.LinearAlgebra.MatrixExponent.Packing.Cell a) (b : OAI.LinearAlgebra.MatrixExponent.Coloring.B (h - a))
  (j : OAI.LinearAlgebra.MatrixExponent.Coloring.B S.e),
  have t := (OAI.LinearAlgebra.MatrixExponent.Assembly.cellIndex (h - a)).symm b;
  have M := p.patternAt a ha v b;
