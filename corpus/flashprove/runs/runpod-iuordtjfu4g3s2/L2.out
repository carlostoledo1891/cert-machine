ℹ [37553/37645] Built AtFullSide.HonestTrace.EntersAtTheWrittenScript (24s)
info: AtFullSide/HonestTrace/EntersAtTheWrittenScript.lean:137:0: @HonestTraceRun.Meets.enters_first_chain_at_the_written_script : ∀ {files : VerifierAndGoals.PublicFiles}
  {A :
    ProofFile.Honest.OnlineProverWithDescription AtPublicFiles.AtFiles.FullSizeMatrix
      ProofFile.Honest.IndexCommitterCoins ProofFile.Honest.Cells Unit Unit},
  ProofFile.Honest.onlineProverFromPublicFiles OnBytes.secondHashFunction files.pol files.lay files.KL
        OnBytes.HonestTrace.EntersAtStoredFiles.baseFilling =
      Except.ok A →
    ∀ (H : ProofFile.Honest.FirstThread.HeadAtReturn files A) (numbers : ProofFile.Honest.FirstThread.FallNumbers)
      {w₀ : AtPublicFiles.AtFiles.FullSizeMatrix} {rc : ProofFile.Honest.IndexCommitterCoins} {ξ : ProofFile.Inst}
      {k : ProofFile.Honest.Coins A.B}
      {R :
        ProofFile.Honest.Ready AtPublicFiles.AtFiles.FullSizeMatrix ProofFile.Honest.IndexCommitterCoins ProofFile.Inst
          OnBytes.TableKey ProofFile.Honest.Cells Unit Unit},
      ProofFile.Honest.ready H.description A.B A.H w₀ rc ξ k = Except.ok R →
        H.description.okStart ξ = true →
          (∀ p ∈ ProofFile.Honest.K2.switchPlaces A.Z A.G,
              ∀ (k : ProofFile.Honest.Coins A.B), (ProofFile.Honest.K2.handed 0 p k).isSome = true) →
            (∀ p ∈ ProofFile.Honest.K2.switchPlaces A.Z A.G,
                ProofFile.Honest.K2.closingOk ProofFile.Honest.K2.freshTable
                    (List.take p.link (ProofFile.Honest.K2.segmentsOf A.Z A.G)) p =
                  true) →
              (∀ p ∈ ProofFile.Honest.K2.switchPlaces A.Z A.G,
                  ∀ (w : ProofFile.Honest.K1.LocB AtPublicFiles.AtFiles.FullSizeMatrix),
                    ProofFile.Honest.ReadyInput H.description A.H w →
                      ProofFile.Honest.K2.publicOk (ProofFile.Honest.widerRows OnBytes.HonestTrace.Sz.ref A.Z A.G)
                          A.G.first.layout p (List.take p.link (ProofFile.Honest.K2.segmentsOf A.Z A.G)) w.x =
                        true) →
                (∀ link < 25,
                    ∀ (number : ℕ) (segment : OnBytes.HonestTrace.Seg),
                      OnBytes.HonestTrace.Sz.ref.matAt link number =
                          some (segment, OnBytes.HonestTrace.planeOf segment) →
                        (Meaning.sizesOf (P5J.At.X A.Z) link).m number =
                            (OnBytes.HonestTrace.Sz.ref.shapeNo link number).1 ∧
                          (Meaning.sizesOf (P5J.At.X A.Z) link).k number =
                            (OnBytes.HonestTrace.Sz.ref.shapeNo link number).2) →
                  ProofFile.Honest.Enters₁ H.description A.H
                    (ProofFile.Honest.FirstThread.firstThread H
                      (ProofFile.Honest.K1.firstParts ProofFile.Honest.Term.matrixInput OnBytes.HonestTrace.Sz.ref
                        ProofFile.Honest.openHonest A H.firstChain numbers)
                      R.own)
                    w₀ rc ξ k R
