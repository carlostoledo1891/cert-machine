$ cat /home/tester/asm/check-fresh.sh
#!/bin/bash
# check-fresh.sh: compiles the five modules (and the audit file) in dependency order from the sources in
# /home/tester/asm into a fresh out-fresh/; out/ is not on the path and is not touched
cd /home/tester/asm
W=$(ls -d /home/tester/work/aaf10926*/canonical)
LP=$(ls -d $W/.lake/packages/*/.lake/build/lib/lean | paste -sd:):$W/.lake/build/lib/lean:/home/tester/asm/out-fresh
LEAN=/home/tester/.elan/toolchains/leanprover--lean4---v4.34.1/bin/lean
rm -rf /home/tester/asm/out-fresh
echo "date: $(date -u +%FT%TZ)"; echo "lean: $($LEAN --version)"; echo "community tree: $W"; echo "community HEAD: $(git -C $W rev-parse HEAD 2>&1)"
echo "LEAN_PATH=$LP"
for f in SubNLogN/Challenge.lean IntMulBridge/Bounds.lean IntMulBridge/Encodings.lean IntMulBridge/Finite.lean IntMulBridge/Main.lean scratch/Audit.lean; do
  M=${f%.lean}; mkdir -p out-fresh/$(dirname $M)
  echo; echo "=== $f"; echo "sha256: $(sha256sum $f)"
  echo "command: env HOME=/home/tester LEAN_PATH=\$LP nice -n 10 $LEAN --root=/home/tester/asm -o out-fresh/$M.olean -i out-fresh/$M.ilean $f"
  S=$(date +%s)
  env HOME=/home/tester LEAN_PATH=$LP nice -n 10 $LEAN --root=/home/tester/asm -o out-fresh/$M.olean -i out-fresh/$M.ilean $f 2>&1
  echo "exit=$? seconds=$(( $(date +%s)-S ))"
done
echo; echo "=== DONE $(date -u +%FT%TZ)"

