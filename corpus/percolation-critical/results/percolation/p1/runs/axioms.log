@Percolation.Continuity.CSH.cshHolds : ∀ {V : Type u_1} [Fintype V] (w : Sym2 V → ↑unitInterval),
  (∀ (e : Sym2 V), 0 < w e ∧ w e < 1) →
    ∀ (x : V) (Y : Set V) (D : List V) (o v : V),
      x ∉ Y →
        o ∉ Insert.insert x Y →
          v ∉ Insert.insert x Y →
            o ≠ v →
              D.Nodup →
                (∀ d ∈ D, d ∉ Insert.insert x Y ∧ d ≠ o ∧ d ≠ v) → Percolation.Continuity.CSH.CSHHolds w x Y D o v
