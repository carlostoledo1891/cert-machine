name = "PercolationContinuity"
version = "0.1.0"
defaultTargets = ["Percolation", "Solution"]

[leanOptions]
autoImplicit = false
relaxedAutoImplicit = false

[[require]]
name = "mathlib"
git = "https://github.com/leanprover-community/mathlib4"
rev = "81a5d257c8e410db227a6665ed08f64fea08e997"  # Mathlib tag v4.32.0

# The formalisation: library `Percolation` (247 modules under Percolation/); root module Percolation.lean imports the main-theorem modules.
[[lean_lib]]
name = "Percolation"

# Palomar submission surface: the Mathlib-only statement file (placeholder proofs by design; not a default target) and its proved twin.
# NOT a default target: build explicitly with `lake build Challenge`.
[[lean_lib]]
name = "Challenge"
roots = ["Challenge"]

[[lean_lib]]
name = "Solution"
roots = ["Solution"]
